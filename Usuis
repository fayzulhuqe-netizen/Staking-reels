      const spriteCache = new Map();

      function getEmojiSprite(emoji, radius) {
        const key = 'e_' + emoji + '_' + radius;
        if (spriteCache.has(key)) return spriteCache.get(key);

        const size = Math.ceil(radius * 2.5);
        const off = document.createElement('canvas');
        off.width = size;
        off.height = size;
        const octx = off.getContext('2d');

        octx.textAlign = 'center';
        octx.textBaseline = 'middle';
        octx.font = Math.round(radius * 1.72) + 'px "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif';
        octx.shadowColor = 'rgba(0, 0, 0, 0.45)';
        octx.shadowBlur = Math.max(4, radius * 0.14);
        octx.shadowOffsetY = Math.max(2, radius * 0.06);
        octx.fillText(emoji, size / 2, size / 2 + radius * 0.06);

        spriteCache.set(key, off);
        return off;
      }

      function getBadgeSprite(item, radius) {
        const key = 'b_' + item.label + '_' + radius;
        if (spriteCache.has(key)) return spriteCache.get(key);

        const size = Math.ceil(radius * 2.45);
        const cx = size / 2;
        const cy = size / 2;
        const r = radius * 0.96;
        const off = document.createElement('canvas');
        off.width = size;
        off.height = size;
        const octx = off.getContext('2d');

        // Outer drop shadow
        octx.save();
        octx.shadowColor = 'rgba(0, 0, 0, 0.55)';
        octx.shadowBlur = Math.max(5, radius * 0.16);
        octx.shadowOffsetY = Math.max(2, radius * 0.07);

        // Main circular glossy gradient medallion
        const grad = octx.createRadialGradient(cx - r * 0.3, cy - r * 0.35, r * 0.1, cx, cy, r);
        grad.addColorStop(0, item.c1);
        grad.addColorStop(1, item.c2);
        octx.fillStyle = grad;
        octx.beginPath();
        octx.arc(cx, cy, r, 0, Math.PI * 2);
        octx.fill();
        octx.restore();

        // Top glossy highlight crescent
        octx.save();
        octx.beginPath();
        octx.arc(cx, cy, r - 2, 0, Math.PI * 2);
        octx.clip();
        const gloss = octx.createLinearGradient(cx, cy - r, cx, cy + r * 0.2);
        gloss.addColorStop(0, 'rgba(255, 255, 255, 0.36)');
        gloss.addColorStop(1, 'rgba(255, 255, 255, 0)');
        octx.fillStyle = gloss;
        octx.beginPath();
        octx.ellipse(cx, cy - r * 0.45, r * 0.88, r * 0.52, 0, 0, Math.PI * 2);
        octx.fill();
        octx.restore();

        // Crisp neon/metallic border ring
        octx.lineWidth = Math.max(2.2, r * 0.065);
        octx.strokeStyle = item.accent;
        octx.beginPath();
        octx.arc(cx, cy, r - octx.lineWidth * 0.5, 0, Math.PI * 2);
        octx.stroke();

        // Center iconic symbol / monogram
        const showLabel = radius >= 38;
        const symbolY = showLabel ? cy - r * 0.14 : cy + r * 0.03;
        const shortLen = item.short.length;
        const symbolSize = Math.round(r * (shortLen >= 3 ? 0.52 : (shortLen === 2 ? 0.72 : 0.92)));
        octx.fillStyle = item.textCol;
        octx.textAlign = 'center';
        octx.textBaseline = 'middle';
        octx.font = '900 ' + symbolSize + 'px "Inter", "Apple Color Emoji", "Segoe UI Emoji", sans-serif';
        octx.shadowColor = 'rgba(0, 0, 0, 0.35)';
        octx.shadowBlur = 4;
        octx.fillText(item.short, cx, symbolY, r * 1.55);

        // Clean bottom brand/character label for medium & larger tiers
        if (showLabel) {
          const pillW = r * 1.48;
          const pillH = Math.max(14, r * 0.32);
          const pillY = cy + r * 0.46;
          octx.shadowBlur = 0;
          octx.fillStyle = 'rgba(0, 0, 0, 0.55)';
          octx.beginPath();
          octx.roundRect(cx - pillW / 2, pillY - pillH / 2, pillW, pillH, pillH / 2);
          octx.fill();

          octx.fillStyle = '#ffffff';
          octx.font = '800 ' + Math.max(9, Math.round(r * 0.19)) + 'px "Inter", sans-serif';
          octx.fillText(item.label, cx, pillY + 0.5, pillW - 8);
        }

        spriteCache.set(key, off);
        return off;
      }

      function buildPngSprite(img, radius) {
        const size = Math.ceil(radius * 2.5);
        const off = document.createElement('canvas');
        off.width = size;
        off.height = size;
        const octx = off.getContext('2d');

        const targetDia = radius * 2.02;
        const iw = img.naturalWidth || img.width || targetDia;
        const ih = img.naturalHeight || img.height || targetDia;
        const scale = targetDia / Math.max(iw, ih);
        const dw = iw * scale;
        const dh = ih * scale;

        octx.shadowColor = 'rgba(0, 0, 0, 0.45)';
        octx.shadowBlur = Math.max(4, radius * 0.12);
        octx.shadowOffsetY = Math.max(2, radius * 0.05);
        octx.drawImage(img, (size - dw) / 2, (size - dh) / 2, dw, dh);
        return off;
      }

      function loadCustomPngForTier(tierIdx, file) {
        if (tierIdx < 0 || tierIdx >= TIER_COUNT || !file) return;
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = function () {
          if (customPngs[tierIdx] && customPngs[tierIdx].url) {
            URL.revokeObjectURL(customPngs[tierIdx].url);
          }
          customPngs[tierIdx] = {
            img: img,
            url: url,
            name: file.name,
            spriteCanvas: buildPngSprite(img, TIER_RADII[tierIdx]),
          };
          renderTierLadder();
          updateStatsUI();
          statusToast.textContent = 'Loaded "' + file.name + '" into Tier ' + (tierIdx + 1) + '.';
        };
        img.onerror = function () {
          URL.revokeObjectURL(url);
          statusToast.textContent = 'Could not load image "' + file.name + '".';
        };
        img.src = url;
      }

      // ============================================================
      // 3. WEB AUDIO ENGINE (SFX + CUSTOM SONG + CUSTOM MERGE CLIP)
      // ============================================================
      let audioCtx = null;
      let masterGain = null;
      let musicGain = null;
      let sfxGain = null;
      let mediaAudioDest = null;

      let customSongBuffer = null;
      let customSongSource = null;
      let customSongOffset = 0;
      let customSongStartedAt = 0;
      let customSfxBuffer = null;

      function ensureAudio() {
        if (!audioCtx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return null;
          audioCtx = new AC();

          masterGain = audioCtx.createGain();
          masterGain.gain.value = state.muted ? 0 : 0.85;
          masterGain.connect(audioCtx.destination);

          musicGain = audioCtx.createGain();
          musicGain.gain.value = state.songVolume;
          musicGain.connect(masterGain);

          sfxGain = audioCtx.createGain();
          sfxGain.gain.value = 0.78;
          sfxGain.connect(masterGain);

          if (typeof audioCtx.createMediaStreamDestination === 'function') {
            mediaAudioDest = audioCtx.createMediaStreamDestination();
            masterGain.connect(mediaAudioDest);
          }
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume().catch(function () {});
        }
        if (audioCtx.state === 'running') {
          audioUnlockBanner.classList.add('hidden');
        }
        return audioCtx;
      }

      function stopCustomSongSource(preserveOffset) {
        if (customSongSource) {
          if (preserveOffset && audioCtx && customSongBuffer && customSongBuffer.duration > 0) {
            const elapsed = audioCtx.currentTime - customSongStartedAt;
            customSongOffset = (customSongOffset + elapsed) % customSongBuffer.duration;
          }
          try {
            customSongSource.stop();
            customSongSource.disconnect();
          } catch (e) {}
          customSongSource = null;
        }
      }

      function startCustomSong(fromZero) {
        if (!customSongBuffer) return;
        const ctxAudio = ensureAudio();
        if (!ctxAudio) return;

        stopCustomSongSource(false);
        if (fromZero) customSongOffset = 0;

        const src = ctxAudio.createBufferSource();
        src.buffer = customSongBuffer;
        src.loop = true;
        src.connect(musicGain);
        const startPos = customSongBuffer.duration > 0 ? (customSongOffset % customSongBuffer.duration) : 0;
        src.start(0, startPos);
        customSongStartedAt = ctxAudio.currentTime;
        customSongSource = src;
      }

      function loadAudioFile(file, target) {
        if (!file) return;
        const ctxAudio = ensureAudio();
        if (!ctxAudio) {
          statusToast.textContent = 'Web Audio is not supported in this browser.';
          return;
        }
        statusToast.textContent = 'Decoding "' + file.name + '"...';
        const reader = new FileReader();
        reader.onload = function (ev) {
          ctxAudio.decodeAudioData(ev.target.result.slice(0))
            .then(function (decoded) {
              if (target === 'song') {
                customSongBuffer = decoded;
                songNameLabel.textContent = file.name;
                songNameLabel.classList.remove('text-slate-400');
                songNameLabel.classList.add('text-fuchsia-300');
                if (state.playing) startCustomSong(true);
                statusToast.textContent = 'Song "' + file.name + '" loaded! Included in recorded video.';
              } else {
                customSfxBuffer = decoded;
                uploadSfxBtn.textContent = '🎙️ SFX: ' + file.name;
                clearSfxBtn.classList.remove('hidden');
                playMergeSound(2);
                statusToast.textContent = 'Custom merge SFX "' + file.name + '" loaded (pitch-shifted by tier).';
              }
            })
            .catch(function () {
              statusToast.textContent = 'Could not decode "' + file.name + '". Try MP3, WAV, or OGG.';
            });
        };
        reader.readAsArrayBuffer(file);
      }

      function playDropTick() {
        if (state.muted || !audioCtx || audioCtx.state !== 'running' || state.audioStyle === 'off') return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(520, now);
        osc.frequency.exponentialRampToValueAtTime(240, now + 0.045);
        gain.gain.setValueAtTime(0.055, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
        osc.connect(gain);
        gain.connect(sfxGain);
        osc.start(now);
        osc.stop(now + 0.055);
      }

      function playMergeSound(tier) {
        if (state.muted || !audioCtx || audioCtx.state !== 'running') return;

        if (customSfxBuffer) {
          const src = audioCtx.createBufferSource();
          const gain = audioCtx.createGain();
          src.buffer = customSfxBuffer;
          src.playbackRate.value = Math.max(0.55, 1.25 - tier * 0.1);
          gain.gain.value = 0.85;
          src.connect(gain);
          gain.connect(sfxGain);
          src.start(0);
          return;
        }

        const style = state.audioStyle;
        if (style === 'off') return;

        const now = audioCtx.currentTime;
        const pentatonic = [261.63, 293.66, 329.63, 392.0, 440.0, 523.25, 587.33, 659.25];
        const idx = Math.min(tier, pentatonic.length - 1);

        if (style === 'popChime') {
          const popOsc = audioCtx.createOscillator();
          const popGain = audioCtx.createGain();
          popOsc.type = 'sine';
          const popStart = 320 + tier * 55;
          popOsc.frequency.setValueAtTime(popStart, now);
          popOsc.frequency.exponentialRampToValueAtTime(popStart * 2.1, now + 0.07);
          popGain.gain.setValueAtTime(0.24, now);
          popGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
          popOsc.connect(popGain);
          popGain.connect(sfxGain);
          popOsc.start(now);
          popOsc.stop(now + 0.095);

          const bellOsc = audioCtx.createOscillator();
          const bellGain = audioCtx.createGain();
          bellOsc.type = 'triangle';
          const freq = pentatonic[idx];
          bellOsc.frequency.setValueAtTime(freq, now);
          bellGain.gain.setValueAtTime(0.28, now);
          bellGain.gain.exponentialRampToValueAtTime(0.001, now + 0.28 + tier * 0.04);
          bellOsc.connect(bellGain);
          bellGain.connect(sfxGain);
          bellOsc.start(now);
          bellOsc.stop(now + 0.34 + tier * 0.04);

          if (tier >= 4) {
            const sub = audioCtx.createOscillator();
            const subGain = audioCtx.createGain();
            sub.type = 'sine';
            sub.frequency.setValueAtTime(110 - (tier - 4) * 14, now);
            sub.frequency.exponentialRampToValueAtTime(42, now + 0.32);
            subGain.gain.setValueAtTime(0.32, now);
            subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
            sub.connect(subGain);
            subGain.connect(sfxGain);
            sub.start(now);
            sub.stop(now + 0.36);
          }
        } else if (style === 'bassDrop') {
          const baseFreq = Math.max(68, 280 - tier * 30);
          const osc = audioCtx.createOscillator();
          const osc2 = audioCtx.createOscillator();
          const gain = audioCtx.createGain();

          osc.type = 'sawtooth';
          osc2.type = 'sine';
          osc.frequency.setValueAtTime(baseFreq * 1.4, now);
          osc.frequency.exponentialRampToValueAtTime(baseFreq * 0.65, now + 0.24);
          osc2.frequency.setValueAtTime(baseFreq, now);
          osc2.frequency.exponentialRampToValueAtTime(baseFreq * 0.5, now + 0.28);

          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(1100 - tier * 70, now);

          gain.gain.setValueAtTime(0.26, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.32 + tier * 0.03);

          osc.connect(filter);
          osc2.connect(filter);
          filter.connect(gain);
          gain.connect(sfxGain);
          osc.start(now);
          osc2.start(now);
          osc.stop(now + 0.36 + tier * 0.03);
          osc2.stop(now + 0.36 + tier * 0.03);
        } else {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'square';
          const f = pentatonic[idx];
          osc.frequency.setValueAtTime(f * 0.75, now);
          osc.frequency.setValueAtTime(f, now + 0.05);
          osc.frequency.setValueAtTime(f * 1.5, now + 0.11);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.24);
          osc.connect(gain);
          gain.connect(sfxGain);
          osc.start(now);
          osc.stop(now + 0.25);
        }
      }

      // ============================================================
      // 4. PHYSICS WORLD (RIGID CIRCLES + CONFETTI + SHOCKWAVES)
      // ============================================================
      let bodies = [];
      let particles = [];
      let shockwaves = [];
      let nextBodyId = 1;

      function spawnBody(tier, x, y, vx, vy, popScale) {
        const r = TIER_RADII[Math.min(tier, TIER_COUNT - 1)];
        bodies.push({
          id: nextBodyId++,
          tier: tier,
          r: r,
          mass: r * r,
          x: x,
          y: y,
          vx: vx || 0,
          vy: vy || 0,
          angle: (Math.random() - 0.5) * 0.35,
          angVel: (Math.random() - 0.5) * 1.6,
          scale: popScale || 1,
          scaleVel: popScale ? 6.5 : 0,
          merged: false,
        });
      }

      function spawnFromChute() {
        const inChute = bodies.filter(function (b) { return b.y < NECK_JOIN_Y + 30; }).length;
        if (inChute >= 4 || bodies.length > 78) return;
        const jitterX = (Math.random() - 0.5) * 28;
        spawnBody(0, CX + jitterX, 28, (Math.random() - 0.5) * 24, 155, 1);
        playDropTick();
      }

      function spawnConfetti(x, y, tier) {
        const count = 14 + tier * 6;
        for (let i = 0; i < count; i++) {
          const ang = Math.random() * Math.PI * 2;
          const speed = 110 + Math.random() * (240 + tier * 38);
          particles.push({
            x: x,
            y: y,
            vx: Math.cos(ang) * speed,
            vy: Math.sin(ang) * speed - 70,
            size: 5 + Math.random() * (5 + tier * 0.75),
            rot: Math.random() * Math.PI * 2,
            rotVel: (Math.random() - 0.5) * 12,
            color: CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)],
            life: 0.55 + Math.random() * 0.45,
            maxLife: 0.95,
          });
        }
        if (tier >= 3) {
          shockwaves.push({
            x: x,
            y: y,
            r: TIER_RADII[tier] * 0.65,
            maxR: TIER_RADII[tier] * 2.25,
            alpha: 0.85,
            color: CONFETTI_COLORS[tier % CONFETTI_COLORS.length],
          });
        }
      }

      function updateStatsUI() {
        const theme = THEMES[state.themeKey];
        mergeCounter.textContent = state.merges + (state.merges === 1 ? ' merge' : ' merges');
        const idx = Math.min(state.highestTier, TIER_COUNT - 1);
        if (customPngs[idx]) {
          highestTierLabel.textContent = 'Best: Tier ' + (idx + 1) + ' (PNG)';
        } else if (theme.type === 'emoji') {
          highestTierLabel.textContent = 'Best: ' + theme.emojis[idx];
        } else {
          highestTierLabel.textContent = 'Best: ' + theme.items[idx].label;
        }
        const loadedCount = customPngs.filter(Boolean).length;
        customPngCount.textContent = loadedCount + '/' + TIER_COUNT + ' PNGs';
      }

      function renderTierLadder() {
        const theme = THEMES[state.themeKey];
        tierLadder.innerHTML = '';
        for (let i = 0; i < TIER_COUNT; i++) {
          const btn = document.createElement('button');
