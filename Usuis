          <optgroup label="Tech, AI &amp; Brands">
            <option value="companies">Company Logos (Spotify → Apple)</option>
            <option value="aiModels">AI Models Logos (Perplexity → Gemini)</option>
            <option value="phoneBrands">Phone Brands (Motorola → Apple)</option>
            <option value="socialMedia">Social Media Apps (Snapchat → YouTube)</option>
