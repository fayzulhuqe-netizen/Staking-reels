    <header class="flex items-start justify-between gap-2">
      <div>
        <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">Merge Physics Short Studio</h1>
        <p class="text-xs text-slate-400 mt-0.5">13 Templates · Custom PNGs · Song · MP4</p>
      </div>
      <div class="text-right">
        <div id="mergeCounter" class="text-xs font-mono font-semibold text-cyan-300">0 merges</div>
        <div id="highestTierLabel" class="text-[11px] text-slate-400">Best: T1</div>
      </div>
    </header>

    <!-- Evolution Ladder & Per-Tier Custom PNG Slots -->
