<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Merge Physics Short Studio — 9:16 MP4 Generator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <style>
    :root {
      color-scheme: dark;
    }
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background: #09090d;
      color: #f1f5f9;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
    }
    .stage-frame {
      aspect-ratio: 9 / 16;
      max-height: calc(100vh - 10rem);
      width: auto;
      max-width: 100%;
    }
    @media (min-width: 1024px) {
      .stage-frame {
        max-height: calc(100vh - 3.5rem);
      }
    }
    canvas#shortCanvas {
      width: 100%;
      height: 100%;
      display: block;
      cursor: pointer;
    }
    input[type="range"] {
      accent-color: #38bdf8;
    }
    @keyframes recPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }
    .rec-dot {
      animation: recPulse 0.9s ease-in-out infinite;
    }
    .panel-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .panel-scroll::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.25);
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen bg-[#09090d] text-slate-100 flex flex-col lg:flex-row items-center justify-center gap-4 lg:gap-8 p-3 sm:p-5">

  <!-- 9:16 Vertical Stage -->
  <main class="relative flex items-center justify-center flex-shrink-0">
    <div id="stageWrapper" class="stage-frame relative rounded-2xl overflow-hidden bg-[#121216] shadow-[0_0_50px_rgba(99,102,241,0.16)] ring-1 ring-white/15">
      <canvas id="shortCanvas" width="720" height="1280" aria-label="Merge Physics Short Canvas"></canvas>

      <!-- Live Recording Badge (DOM overlay only - excluded from video capture) -->
      <div id="recBadge" class="hidden absolute top-3 left-3 z-20 flex items-center gap-2 px-2.5 py-1 rounded-full bg-red-600/90 text-white text-xs font-semibold tracking-wide shadow-lg backdrop-blur-sm">
        <span class="rec-dot w-2 h-2 rounded-full bg-white"></span>
        <span id="recBadgeText">REC 00.0s</span>
      </div>

      <!-- Tap for Audio Hint (hides automatically once Web Audio unlocks) -->
      <button id="audioUnlockBanner" type="button" class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-full bg-black/70 hover:bg-black/85 border border-white/15 text-[11px] font-semibold text-amber-300 backdrop-blur-sm transition flex items-center gap-1.5">
        <span>🔊</span>
        <span>Tap to enable sound</span>
      </button>

      <!-- Format Pill -->
      <div class="pointer-events-none absolute top-3 right-3 z-10 px-2 py-0.5 rounded-md bg-black/55 border border-white/10 text-[11px] font-medium text-slate-300 backdrop-blur-sm">
        9:16 · 60 FPS
      </div>
    </div>
  </main>

  <!-- Studio Control Panel -->
