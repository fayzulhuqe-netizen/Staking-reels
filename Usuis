      function resetWorld() {
        bodies = [];
        particles = [];
        shockwaves = [];
        state.merges = 0;
        state.highestTier = 0;
        state.finalReachedAtMs = null;
        state.dropTimer = 0.08;
        updateStatsUI();
        renderTierLadder();
        spawnBody(0, CX - 6, 80, 12, 160, 1);
        spawnBody(0, CX + 8, 250, -10, 210, 1);
        if (customSongBuffer && state.playing) {
          startCustomSong(true);
        }
      }

      // ============================================================
      // 5. SUB-STEPPED 2D PHYSICS ENGINE
      // ============================================================
      const GRAVITY = 1320;
      const RESTITUTION = 0.42;
      const SUBSTEPS = 6;

      function stepPhysics(dt) {
        const subDt = dt / SUBSTEPS;
        const maxTier = TIER_COUNT - 1;

        for (let step = 0; step < SUBSTEPS; step++) {
          for (let i = 0; i < bodies.length; i++) {
            const b = bodies[i];
            if (b.merged) continue;
            b.vy += GRAVITY * subDt;
            b.x += b.vx * subDt;
            b.y += b.vy * subDt;
            b.angle += b.angVel * subDt;
            b.angVel *= 0.996;
            b.vx *= 0.9992;

            if (Math.abs(1 - b.scale) > 0.002 || Math.abs(b.scaleVel) > 0.002) {
              const force = (1 - b.scale) * 260;
              b.scaleVel = (b.scaleVel + force * subDt) * Math.pow(0.08, subDt);
              b.scale += b.scaleVel * subDt;
            } else {
              b.scale = 1;
              b.scaleVel = 0;
            }
          }

          const mergesToCreate = [];
          for (let i = 0; i < bodies.length; i++) {
            const a = bodies[i];
            if (a.merged) continue;
            for (let j = i + 1; j < bodies.length; j++) {
              const b = bodies[j];
              if (b.merged) continue;

              const dx = b.x - a.x;
              const dy = b.y - a.y;
              const minDist = a.r + b.r;
              const distSq = dx * dx + dy * dy;

              if (distSq < minDist * minDist) {
                if (a.tier === b.tier && a.tier < maxTier && a.y > NECK_JOIN_Y - 10 && b.y > NECK_JOIN_Y - 10) {
                  a.merged = true;
                  b.merged = true;
                  mergesToCreate.push({
                    tier: a.tier + 1,
                    x: (a.x + b.x) * 0.5,
                    y: (a.y + b.y) * 0.5,
                    vx: (a.vx + b.vx) * 0.35,
                    vy: Math.min((a.vy + b.vy) * 0.35, -90),
                  });
                  break;
                }

                const dist = Math.sqrt(distSq) || 0.001;
                const nx = dx / dist;
                const ny = dy / dist;
                const overlap = minDist - dist;

                const totalMass = a.mass + b.mass;
                const ratioA = b.mass / totalMass;
                const ratioB = a.mass / totalMass;

                a.x -= nx * overlap * ratioA;
                a.y -= ny * overlap * ratioA;
                b.x += nx * overlap * ratioB;
                b.y += ny * overlap * ratioB;

                const rvx = b.vx - a.vx;
                const rvy = b.vy - a.vy;
                const velAlongNormal = rvx * nx + rvy * ny;

                if (velAlongNormal < 0) {
                  const impulse = -(1 + RESTITUTION) * velAlongNormal / (1 / a.mass + 1 / b.mass);
                  const ix = impulse * nx;
                  const iy = impulse * ny;
                  a.vx -= ix / a.mass;
                  a.vy -= iy / a.mass;
                  b.vx += ix / b.mass;
                  b.vy += iy / b.mass;

                  const tx = -ny;
                  const ty = nx;
                  const tangentVel = rvx * tx + rvy * ty;
                  a.angVel += tangentVel * 0.0018;
                  b.angVel -= tangentVel * 0.0018;
                }
              }
            }
          }

          if (mergesToCreate.length > 0) {
            bodies = bodies.filter(function (b) { return !b.merged; });
            for (let m = 0; m < mergesToCreate.length; m++) {
              const mc = mergesToCreate[m];
              spawnBody(mc.tier, mc.x, mc.y, mc.vx, mc.vy, 0.45);
              spawnConfetti(mc.x, mc.y, mc.tier);
              playMergeSound(mc.tier);
              state.merges++;
              if (mc.tier > state.highestTier) {
                state.highestTier = mc.tier;
                renderTierLadder();
              }
              if (mc.tier === maxTier && state.recording && state.finalReachedAtMs === null) {
                state.finalReachedAtMs = performance.now();
                statusToast.textContent = 'Final Tier reached! Recording 3s celebration before saving...';
              }
            }
            updateStatsUI();
          }

          for (let i = 0; i < bodies.length; i++) {
            const b = bodies[i];
            if (b.y < NECK_JOIN_Y + 6) {
              const leftWall = CX - NECK_HALF_W + b.r;
              const rightWall = CX + NECK_HALF_W - b.r;
              if (b.x < leftWall) {
                b.x = leftWall;
                b.vx = Math.abs(b.vx) * RESTITUTION;
              } else if (b.x > rightWall) {
                b.x = rightWall;
                b.vx = -Math.abs(b.vx) * RESTITUTION;
              }
            } else {
              const dx = b.x - CX;
              const dy = b.y - CY;
              const dist = Math.sqrt(dx * dx + dy * dy) || 0.001;
              const maxR = ARENA_R - b.r;

              const inTopOpening = dy < 0 && Math.abs(dx) < NECK_HALF_W - b.r * 0.4 && b.tier === 0;
              if (dist > maxR && !inTopOpening) {
                const nx = dx / dist;
                const ny = dy / dist;
                b.x = CX + nx * maxR;
                b.y = CY + ny * maxR;

                const vn = b.vx * nx + b.vy * ny;
                if (vn > 0) {
                  b.vx -= (1 + RESTITUTION) * vn * nx;
                  b.vy -= (1 + RESTITUTION) * vn * ny;
                  const tx = -ny;
                  const ty = nx;
                  const vt = b.vx * tx + b.vy * ty;
                  b.angVel = vt / Math.max(b.r, 12);
                }
              }
            }
          }
        }

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.vy += 620 * dt;
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.rot += p.rotVel * dt;
          p.life -= dt;
          if (p.life <= 0) particles.splice(i, 1);
        }

        for (let i = shockwaves.length - 1; i >= 0; i--) {
          const sw = shockwaves[i];
          sw.r += (sw.maxR - sw.r) * Math.min(1, dt * 11);
          sw.alpha -= dt * 2.6;
          if (sw.alpha <= 0) shockwaves.splice(i, 1);
        }
      }

      // ============================================================
      // 6. CANVAS RENDERING
      // ============================================================
      function drawArena() {
        ctx.fillStyle = '#121216';
        ctx.fillRect(0, 0, W, H);

        const bgGlow = ctx.createRadialGradient(CX, CY, ARENA_R * 0.2, CX, CY, ARENA_R * 1.25);
        bgGlow.addColorStop(0, 'rgba(34, 211, 238, 0.045)');
        bgGlow.addColorStop(1, 'rgba(18, 18, 22, 0)');
        ctx.fillStyle = bgGlow;
        ctx.fillRect(0, 0, W, H);

        ctx.save();
        ctx.lineWidth = 3.5;
        ctx.lineCap = 'round';
        ctx.strokeStyle = 'rgba(203, 213, 225, 0.45)';
        ctx.beginPath();
        ctx.moveTo(CX - NECK_HALF_W, NECK_TOP_Y);
        ctx.lineTo(CX - NECK_HALF_W, NECK_JOIN_Y);
        ctx.moveTo(CX + NECK_HALF_W, NECK_TOP_Y);
        ctx.lineTo(CX + NECK_HALF_W, NECK_JOIN_Y);
        ctx.stroke();

        const startAng = -Math.PI / 2 + NECK_JOIN_ANGLE;
        const endAng = Math.PI * 1.5 - NECK_JOIN_ANGLE;
        const grad = ctx.createLinearGradient(
          CX + Math.cos(state.rainbowPhase) * ARENA_R,
          CY + Math.sin(state.rainbowPhase) * ARENA_R,
          CX - Math.cos(state.rainbowPhase) * ARENA_R,
          CY - Math.sin(state.rainbowPhase) * ARENA_R
        );
        grad.addColorStop(0.0, '#ff3b30');
        grad.addColorStop(0.18, '#ff9500');
        grad.addColorStop(0.36, '#ffd60a');
        grad.addColorStop(0.54, '#34c759');
        grad.addColorStop(0.72, '#00c7be');
        grad.addColorStop(0.86, '#5856d6');
        grad.addColorStop(1.0, '#ff2d55');

        ctx.shadowColor = 'rgba(0, 240, 255, 0.35)';
        ctx.shadowBlur = 14;
        ctx.lineWidth = 4.5;
        ctx.strokeStyle = grad;
        ctx.beginPath();
        ctx.arc(CX, CY, ARENA_R, startAng, endAng);
        ctx.stroke();
        ctx.restore();
      }

      function drawEntities() {
        const theme = THEMES[state.themeKey];

        for (let i = 0; i < shockwaves.length; i++) {
          const sw = shockwaves[i];
          ctx.save();
          ctx.globalAlpha = Math.max(0, sw.alpha);
          ctx.strokeStyle = sw.color;
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        const sorted = bodies.slice().sort(function (a, b) { return a.tier - b.tier; });
        for (let i = 0; i < sorted.length; i++) {
          const b = sorted[i];
          const idx = Math.min(b.tier, TIER_COUNT - 1);
          const customSlot = customPngs[idx];
          let sprite;
          if (customSlot) {
            sprite = customSlot.spriteCanvas;
          } else if (theme.type === 'emoji') {
            sprite = getEmojiSprite(theme.emojis[idx], b.r);
          } else {
            sprite = getBadgeSprite(theme.items[idx], b.r);
          }

          ctx.save();
          ctx.translate(b.x, b.y);
          ctx.rotate(b.angle);
          ctx.scale(b.scale, b.scale);
          ctx.drawImage(sprite, -sprite.width / 2, -sprite.height / 2);
          ctx.restore();
        }

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          ctx.save();
          ctx.globalAlpha = Math.max(0, Math.min(1, p.life / 0.35));
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.moveTo(0, -p.size * 0.65);
          ctx.lineTo(p.size * 0.6, p.size * 0.55);
          ctx.lineTo(-p.size * 0.6, p.size * 0.55);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }
      }

      function drawCaption() {
        const text = (state.caption || '').trim();
        if (!text) return;

        ctx.save();
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = '800 34px "Inter", system-ui, -apple-system, sans-serif';
        ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
        ctx.shadowBlur = 10;
        ctx.fillText(text, CX, CY + ARENA_R + 95, W - 72);
        ctx.restore();
      }

      // ============================================================
      // 7. MP4-FIRST RECORDER (H.264/AAC MP4 WITH WEBM FALLBACK)
      // ============================================================
      let mediaRecorder = null;
      let recordedChunks = [];

      function detectBestFormat() {
        if (typeof MediaRecorder === 'undefined') {
          return { mimeType: null, ext: 'mp4', isMp4: false };
        }
        const mp4Candidates = [
          'video/mp4;codecs=avc1.42E01E,mp4a.40.2',
          'video/mp4;codecs=avc1.4d002a,mp4a.40.2',
          'video/mp4;codecs=avc1,mp4a.40.2',
          'video/mp4;codecs=avc1',
          'video/mp4',
        ];
        for (let i = 0; i < mp4Candidates.length; i++) {
          if (MediaRecorder.isTypeSupported(mp4Candidates[i])) {
            return { mimeType: mp4Candidates[i], ext: 'mp4', isMp4: true };
          }
        }
        const webmCandidates = [
          'video/webm;codecs=vp9,opus',
          'video/webm;codecs=vp8,opus',
          'video/webm;codecs=vp9',
          'video/webm',
        ];
        for (let i = 0; i < webmCandidates.length; i++) {
          if (MediaRecorder.isTypeSupported(webmCandidates[i])) {
            return { mimeType: webmCandidates[i], ext: 'webm', isMp4: false };
          }
        }
        return { mimeType: '', ext: 'mp4', isMp4: true };
      }

      const detectedFmt = detectBestFormat();
      if (detectedFmt.mimeType === null) {
        formatSupportBadge.textContent = 'Unsupported';
        formatSupportBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-rose-500/15 text-rose-300 border border-rose-400/30';
      } else if (detectedFmt.isMp4) {
        formatSupportBadge.textContent = 'MP4 (H.264)';
        recordBtnText.textContent = 'Record MP4 + Audio';
      } else {
        formatSupportBadge.textContent = 'WebM (Browser Fallback)';
        formatSupportBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-400/30';
        recordBtnText.textContent = 'Record Video + Audio';
      }

      function stopRecording(early) {
        if (!state.recording) return;
        state.recording = false;
        recBadge.classList.add('hidden');
        recProgressWrap.classList.add('hidden');
        recordBtnText.textContent = detectedFmt.isMp4 ? 'Record MP4 + Audio' : 'Record Video + Audio';
        recordModeSelect.disabled = false;
        customDurationInput.disabled = false;

        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
          mediaRecorder.stop();
        }
        if (early) {
          statusToast.textContent = 'Stopped early. Finalizing ' + detectedFmt.ext.toUpperCase() + ' file...';
        }
      }

      function startRecording() {
        if (state.recording) {
          stopRecording(true);
          return;
        }

        if (detectedFmt.mimeType === null || typeof canvas.captureStream !== 'function') {
          statusToast.textContent = 'Video recording is not supported in this browser. Use Chrome, Edge, or Safari.';
          return;
        }

        ensureAudio();
        state.recordMode = recordModeSelect.value;
        const parsedSec = parseInt(customDurationInput.value, 10);
        state.recordDuration = Math.max(5, Math.min(300, isNaN(parsedSec) ? 60 : parsedSec));
        customDurationInput.value = String(state.recordDuration);
        state.finalReachedAtMs = null;

        state.playing = true;
        playPauseBtn.textContent = '❚❚ Pause';
        resetWorld();

        const videoStream = canvas.captureStream(60);
        const tracks = videoStream.getVideoTracks().slice();
        if (mediaAudioDest && mediaAudioDest.stream) {
          const audioTracks = mediaAudioDest.stream.getAudioTracks();
          for (let i = 0; i < audioTracks.length; i++) {
            tracks.push(audioTracks[i]);
          }
        }
        const combinedStream = new MediaStream(tracks);

        recordedChunks = [];
        const options = detectedFmt.mimeType
          ? { mimeType: detectedFmt.mimeType, videoBitsPerSecond: 8500000 }
          : { videoBitsPerSecond: 8500000 };

        try {
          mediaRecorder = new MediaRecorder(combinedStream, options);
        } catch (err) {
          statusToast.textContent = 'Could not start recorder: ' + (err && err.message ? err.message : 'unsupported');
          return;
        }

        mediaRecorder.ondataavailable = function (e) {
          if (e.data && e.data.size > 0) recordedChunks.push(e.data);
        };

        mediaRecorder.onstop = function () {
          if (recordedChunks.length === 0) {
            statusToast.textContent = 'No video frames captured.';
            return;
          }
          const blob = new Blob(recordedChunks, { type: detectedFmt.mimeType || 'video/mp4' });
          if (state.lastBlobUrl) URL.revokeObjectURL(state.lastBlobUrl);
          state.lastBlobUrl = URL.createObjectURL(blob);

          const hasCustom = customPngs.some(Boolean);
          const prefix = hasCustom ? 'custom-merge-' : (state.themeKey + '-merge-');
          const durTag = state.recordMode === 'untilFinal' ? 'full' : (state.recordDuration + 's');
          const filename = prefix + durTag + '.' + detectedFmt.ext;
          downloadLink.href = state.lastBlobUrl;
          downloadLink.download = filename;
          downloadLink.textContent = 'Download ' + filename;
          downloadLink.classList.remove('hidden');

          const a = document.createElement('a');
          a.href = state.lastBlobUrl;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);

          const mb = (blob.size / (1024 * 1024)).toFixed(2);
          statusToast.textContent = 'Saved ' + filename + ' (' + mb + ' MB) with audio.';
        };

        state.recording = true;
        state.recordStartMs = performance.now();
        recordModeSelect.disabled = true;
        customDurationInput.disabled = true;
        recBadge.classList.remove('hidden');
        recProgressWrap.classList.remove('hidden');
        recProgressBar.style.width = '0%';
        recordBtnText.textContent = 'Stop & Save Now';

        const modeText = state.recordMode === 'untilFinal'
          ? 'until Final Tier (+3s, max ' + state.recordDuration + 's)'
          : (state.recordDuration + 's');
        statusToast.textContent = 'Recording ' + detectedFmt.ext.toUpperCase() + ' (' + modeText + ') @ 60 FPS...';

        mediaRecorder.start(250);
      }

      // ============================================================
      // 8. EVENT LISTENERS
      // ============================================================
      audioUnlockBanner.addEventListener('click', function () {
        ensureAudio();
        if (customSongBuffer && !customSongSource && state.playing) {
          startCustomSong(false);
        } else {
          playMergeSound(2);
        }
      });

      canvas.addEventListener('click', function () {
        ensureAudio();
        if (customSongBuffer && !customSongSource && state.playing) {
          startCustomSong(false);
        }
        spawnFromChute();
      });

      tierLadder.addEventListener('click', function (e) {
        const btn = e.target.closest('button[data-tier]');
        if (!btn) return;
        state.pendingPngTier = parseInt(btn.dataset.tier, 10) || 0;
        singlePngInput.value = '';
        singlePngInput.click();
      });

      singlePngInput.addEventListener('change', function () {
        if (singlePngInput.files && singlePngInput.files[0]) {
          loadCustomPngForTier(state.pendingPngTier, singlePngInput.files[0]);
        }
      });

      bulkPngBtn.addEventListener('click', function () {
        bulkPngInput.value = '';
        bulkPngInput.click();
      });

      bulkPngInput.addEventListener('change', function () {
        const files = Array.from(bulkPngInput.files || []).slice(0, TIER_COUNT);
        if (files.length === 0) return;
        for (let i = 0; i < files.length; i++) {
          loadCustomPngForTier(i, files[i]);
        }
        statusToast.textContent = 'Loading ' + files.length + ' custom PNG(s) into Tiers 1–' + files.length + '...';
      });

      clearPngsBtn.addEventListener('click', function () {
        for (let i = 0; i < TIER_COUNT; i++) {
          if (customPngs[i] && customPngs[i].url) {
            URL.revokeObjectURL(customPngs[i].url);
          }
          customPngs[i] = null;
        }
        renderTierLadder();
        updateStatsUI();
        statusToast.textContent = 'Cleared custom PNGs. Using active template pack.';
      });

      uploadSongBtn.addEventListener('click', function () {
        ensureAudio();
        songFileInput.value = '';
        songFileInput.click();
      });

      songFileInput.addEventListener('change', function () {
        if (songFileInput.files && songFileInput.files[0]) {
          loadAudioFile(songFileInput.files[0], 'song');
        }
      });

      clearSongBtn.addEventListener('click', function () {
        stopCustomSongSource(false);
        customSongBuffer = null;
        customSongOffset = 0;
        songNameLabel.textContent = 'No song';
        songNameLabel.classList.remove('text-fuchsia-300');
        songNameLabel.classList.add('text-slate-400');
        statusToast.textContent = 'Cleared custom song.';
      });

      songVolumeSlider.addEventListener('input', function () {
        state.songVolume = parseFloat(songVolumeSlider.value);
        songVolumeVal.textContent = Math.round(state.songVolume * 100) + '%';
        if (musicGain && audioCtx) {
          musicGain.gain.setTargetAtTime(state.songVolume, audioCtx.currentTime, 0.02);
        }
      });

      uploadSfxBtn.addEventListener('click', function () {
        ensureAudio();
        sfxFileInput.value = '';
        sfxFileInput.click();
      });

      sfxFileInput.addEventListener('change', function () {
        if (sfxFileInput.files && sfxFileInput.files[0]) {
          loadAudioFile(sfxFileInput.files[0], 'sfx');
        }
      });

      clearSfxBtn.addEventListener('click', function () {
        customSfxBuffer = null;
        uploadSfxBtn.textContent = '🎙️ Upload Custom Merge SFX';
        clearSfxBtn.classList.add('hidden');
        statusToast.textContent = 'Reverted to built-in synthesized merge SFX.';
      });

      playPauseBtn.addEventListener('click', function () {
        ensureAudio();
        state.playing = !state.playing;
        playPauseBtn.textContent = state.playing ? '❚❚ Pause' : '▶ Play';
        if (customSongBuffer) {
          if (state.playing) {
            startCustomSong(false);
          } else {
            stopCustomSongSource(true);
          }
        }
      });

      dropNowBtn.addEventListener('click', function () {
        ensureAudio();
        spawnFromChute();
      });

      resetBtn.addEventListener('click', function () {
        ensureAudio();
        resetWorld();
      });

      themeSelect.addEventListener('change', function () {
        ensureAudio();
        state.themeKey = themeSelect.value;
        state.caption = THEMES[state.themeKey].caption;
        captionInput.value = state.caption;
        resetWorld();
      });

      audioStyleSelect.addEventListener('change', function () {
        ensureAudio();
        state.audioStyle = audioStyleSelect.value;
        playMergeSound(3);
      });

      muteBtn.addEventListener('click', function () {
        ensureAudio();
        state.muted = !state.muted;
        if (masterGain && audioCtx) {
          masterGain.gain.setTargetAtTime(state.muted ? 0 : 0.85, audioCtx.currentTime, 0.02);
        }
        muteBtn.textContent = state.muted ? '🔇 Muted' : '🔊 Sound On';
        muteBtn.classList.toggle('text-emerald-300', !state.muted);
        muteBtn.classList.toggle('text-rose-400', state.muted);
      });

      dropRateSlider.addEventListener('input', function () {
        state.dropInterval = parseFloat(dropRateSlider.value) || 0.38;
        dropRateVal.textContent = state.dropInterval.toFixed(2) + 's';
      });

      captionInput.addEventListener('input', function () {
        state.caption = captionInput.value;
      });

      durationPresets.addEventListener('click', function (e) {
        const btn = e.target.closest('button[data-sec]');
        if (!btn) return;
        customDurationInput.value = btn.dataset.sec;
        recordModeSelect.value = 'custom';
      });

      recordBtn.addEventListener('click', startRecording);

      // ============================================================
      // 9. MAIN LOOP (60 FPS)
      // ============================================================
      function loop(now) {
        requestAnimationFrame(loop);

        if (!state.lastTs) state.lastTs = now;
        const dt = Math.min((now - state.lastTs) / 1000, 0.05);
        state.lastTs = now;

        if (state.playing) {
          state.rainbowPhase += dt * 0.9;
          state.dropTimer -= dt;
          if (state.dropTimer <= 0) {
            spawnFromChute();
            state.dropTimer = state.dropInterval;
          }
          stepPhysics(dt);
        }

        drawArena();
        drawEntities();
        drawCaption();

        if (state.recording) {
          const elapsed = (now - state.recordStartMs) / 1000;
          const pct = Math.min(100, (elapsed / state.recordDuration) * 100);
          recProgressBar.style.width = pct.toFixed(1) + '%';

          if (state.recordMode === 'untilFinal') {
            recBadgeText.textContent = 'REC ' + elapsed.toFixed(1) + 's (T' + (state.highestTier + 1) + '/8)';
            if (state.finalReachedAtMs !== null && (now - state.finalReachedAtMs) >= 3000) {
              stopRecording(false);
            } else if (elapsed >= state.recordDuration) {
              stopRecording(false);
            }
          } else {
            recBadgeText.textContent = 'REC ' + elapsed.toFixed(1).padStart(4, '0') + 's / ' + state.recordDuration + 's';
            if (elapsed >= state.recordDuration) {
              stopRecording(false);
            }
          }
        }
      }

      // Initialize
      resetWorld();
      requestAnimationFrame(loop);
    })();
  </script>
</body>
</html>
