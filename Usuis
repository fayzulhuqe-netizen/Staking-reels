      </div>
      <div id="tierLadder" class="grid grid-cols-8 gap-1 select-none"></div>
      <div class="flex items-center gap-2 pt-0.5">
        <button id="bulkPngBtn" type="button" class="flex-1 px-2.5 py-1.5 rounded-lg bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-400/30 text-[11px] font-semibold text-cyan-200 transition">
          + Upload PNGs (T1–T8)
        </button>
        <button id="clearPngsBtn" type="button" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-white/10 text-[11px] font-semibold text-slate-300 transition">
          Clear PNGs
        </button>
      </div>
      <input id="singlePngInput" type="file" accept="image/png,image/webp,image/jpeg,image/gif" class="hidden" />
      <input id="bulkPngInput" type="file" accept="image/png,image/webp,image/jpeg,image/gif" multiple class="hidden" />
    </section>

    <!-- Playback & Drop Controls -->
